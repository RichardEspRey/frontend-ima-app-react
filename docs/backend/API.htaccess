# /public_html/API/.htaccess
#
# Es el archivo que ya estaba (las tres primeras líneas útiles) más la compresión.
# Para volver atrás: dejar solo el bloque de mod_rewrite.

# Desactivar el rewrite heredado de WordPress en esta carpeta
<IfModule mod_rewrite.c>
RewriteEngine Off
</IfModule>

# Comprimir las respuestas de la API.
#
# Ninguna respuesta iba comprimida: Admin gastos bajaba 1.48 MB y Ventas 758 KB en
# cada carga. El JSON comprime unas ocho veces. Solo se comprime a quien avisa que
# lo acepta (cabecera Accept-Encoding), así que un cliente viejo recibe lo mismo
# que hoy. Si el servidor no tiene mod_deflate, este bloque no hace nada.
#
# text/html va incluido porque varios PHP —Tracking.php entre ellos— devuelven JSON
# sin declarar su tipo. Imágenes y PDF de Uploads no se tocan.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/json text/html text/plain
</IfModule>

# No servir por web los registros de la carpeta.
#
# Se podían bajar desde el navegador sin iniciar sesión. Revisados el 2026-11-17:
#   debug_request.log   · un inicio de sesión con usuario y contraseña en claro
#   dist_nv_laredo.log  · la posición GPS de cada camión, minuto a minuto
#   diesel_job.log      · consumo y combustible de cada camión (28 MB)
# Los procesos automáticos los siguen escribiendo igual: eso no pasa por Apache.
<FilesMatch "\.log$">
Require all denied
</FilesMatch>

# La librería de la bitácora solo la carga conexion.php por dentro, que no pasa por
# Apache. Desde el navegador no tiene nada que hacer: se cierra para que nadie pueda
# llamarla directo y llenar la bitácora de filas falsas.
<Files "bitacora_lib.php">
Require all denied
</Files>
